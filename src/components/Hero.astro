---
import { wedding } from '../data/wedding';
const { couple, bigDay } = wedding;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<section class="hero" id="hero">
  <!-- Soft golden bloom that breathes in as the curtains part -->
  <div class="hero-bloom" aria-hidden="true"></div>

  <!-- watercolor garland valance across the top -->
  <img
    class="hero-garland"
    src={`${base}/img/garland-light.webp`}
    alt=""
    width="1280"
    height="616"
    loading="eager"
    decoding="async"
  />

  <!-- Gold monogram wreath with the couple's initials -->
  <div class="hero-couple" aria-hidden="true">
    <span class="couple-glow"></span>
    <img
      src={`${base}/img/wreath.webp`}
      alt=""
      width="800"
      height="665"
      loading="eager"
      decoding="async"
    />
    <span class="monogram-text script">S &amp; H</span>
  </div>

  <div class="hero-inner">
    <p class="eyebrow">Together With Their Families</p>

    <div class="hero-names">
      <span class="name">{couple.groom.name}</span>
      <span class="amp">and</span>
      <span class="name">{couple.bride.name}</span>
    </div>

    <!-- Intertwined rings -->
    <svg class="rings" viewBox="0 0 90 44" aria-hidden="true">
      <circle cx="33" cy="24" r="15" />
      <circle cx="57" cy="24" r="15" />
      <path class="ring-gem" d="M57 5 l5 6 -5 6 -5 -6 z" />
    </svg>

    <div class="gold-rule"></div>
    <p class="hero-date">{bigDay.display}</p>

    <div class="scroll-cue">
      <span>Scroll Down</span>
      <span class="line"></span>
    </div>
  </div>
</section>
