---
import { wedding } from '../data/wedding';
const { bigDay } = wedding;
const cells = [
  { key: 'day', value: bigDay.scratch.day },
  { key: 'month', value: bigDay.scratch.month },
  { key: 'year', value: bigDay.scratch.year },
];
const units = ['Days', 'Hours', 'Minutes', 'Seconds'];
---

<!-- Heart shape used to clip the scratch cells (objectBoundingBox = scales with the cell) -->
<svg width="0" height="0" style="position:absolute" aria-hidden="true">
  <defs>
    <clipPath id="heart-clip" clipPathUnits="objectBoundingBox">
      <path
        d="M0.5 0.943 C 0.133 0.657, 0.027 0.4, 0.12 0.229 C 0.213 0.057, 0.44 0.086, 0.5 0.271 C 0.56 0.086, 0.787 0.057, 0.88 0.229 C 0.973 0.4, 0.867 0.657, 0.5 0.943 Z"
      />
    </clipPath>
  </defs>
</svg>

<section class="std center" id="save-the-date" data-target={bigDay.iso}>
  <div class="container">
    <div class="reveal-group">
      <p class="eyebrow">Save The Date</p>
      <h2 class="section-title">Scratch To Discover</h2>
      <p class="std-hint" id="std-hint">Scratch all three hearts — or simply reveal it</p>
    </div>

    <div class="scratch-row" id="scratch-row">
      {cells.map((c) => (
        <div class="scratch-cell" data-cell={c.key}>
          <span class="scratch-value">{c.value}</span>
          <canvas class="scratch-foil" width="150" height="140" aria-hidden="true"></canvas>
        </div>
      ))}
    </div>

    <button class="btn std-reveal" id="std-reveal" type="button">Reveal The Date</button>

    <div class="std-date" id="std-date" aria-live="polite">
      <p class="std-date-label">Insha Allah, on</p>
      <p class="std-date-value">{bigDay.display}</p>
    </div>

    <div class="countdown" id="countdown">
      {units.map((u) => (
        <div class="count-tile">
          <div class="value" data-unit={u.toLowerCase()}>00</div>
          <div class="unit">{u}</div>
        </div>
      ))}
    </div>
  </div>
</section>
