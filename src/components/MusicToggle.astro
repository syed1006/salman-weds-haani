---
import { wedding } from '../data/wedding';

// base-aware audio path ('' locally, '/salman-weds-haani' on GitHub Pages)
const src = `${import.meta.env.BASE_URL.replace(/\/$/, '')}${wedding.music}`;
---

<!-- Floating music toggle; hides itself if the audio file is missing -->
<button class="music-toggle" id="music-toggle" type="button" aria-label="Toggle music" hidden>
  <svg viewBox="0 0 24 24" aria-hidden="true">
    <path d="M9 18 V6 L20 4 V16" />
    <circle cx="6.5" cy="18" r="2.6" />
    <circle cx="17.5" cy="16" r="2.6" />
  </svg>
</button>
<audio id="bg-music" src={src} loop preload="none"></audio>
