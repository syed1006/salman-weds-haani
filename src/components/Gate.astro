---
import { wedding } from '../data/wedding';
const { couple } = wedding;

// base-aware asset prefix ('' locally, or the repo path on project pages)
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<!-- Full-screen entry gate: a sealed envelope — tap to open the invitation -->
<div class="gate" id="gate" data-lottie={`${base}/lottie/envelope/data.json`}>
  <!-- watercolor garland valance: a seamless mirror-tile, so it drapes
       across any screen width with its natural hanging edge intact -->
  <div
    class="gate-garland"
    style={`background-image:url('${base}/img/garland-band-full.webp')`}
    aria-hidden="true"
  >
  </div>

  <!-- twinkling gold sparkles -->
  <span class="sparkle" aria-hidden="true"></span>
  <span class="sparkle" aria-hidden="true"></span>
  <span class="sparkle" aria-hidden="true"></span>
  <span class="sparkle" aria-hidden="true"></span>
  <span class="sparkle" aria-hidden="true"></span>
  <span class="sparkle" aria-hidden="true"></span>
  <span class="sparkle" aria-hidden="true"></span>
  <span class="sparkle" aria-hidden="true"></span>

  <div class="gate-inner">
    <p class="gate-bismillah arabic">بِسْمِ اللَّهِ الرَّحْمَٰنِ الرَّحِيمِ</p>
    <p class="eyebrow">The Wedding Invitation Of</p>
    <p class="gate-names script">{couple.shortNames}</p>

    <button class="gate-envelope" id="gate-open" type="button" aria-label="Open invitation">
      <span class="light-burst" aria-hidden="true"></span>
      <div class="gate-lottie" id="gate-lottie"></div>
    </button>

    <p class="gate-hint" id="gate-hint">Tap the envelope to open</p>
  </div>
</div>

<!-- white flash used for the reveal transition -->
<div class="flash" id="flash" aria-hidden="true"></div>

<noscript>
  <style>
    .gate { display: none !important; }
    body { overflow: auto !important; }
  </style>
</noscript>
