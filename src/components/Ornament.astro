---
// Gold roses that draw themselves in as the divider scrolls into view.
// Falls back to a simple gold rule when the animation can't run.
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<div class="ornament" data-roses={`${base}/lottie/roses.json`}>
  <div class="ornament-lottie" aria-hidden="true"></div>
  <svg class="ornament-fallback" viewBox="0 0 260 24" aria-hidden="true">
    <path d="M10 12 H105 M155 12 H250" />
    <path class="diamond" d="M130 4 l9 8 -9 8 -9 -8 z" />
  </svg>
</div>
