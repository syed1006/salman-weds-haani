---
import '@fontsource/cormorant-garamond/500.css';
import '@fontsource/cormorant-garamond/600.css';
import '@fontsource/cormorant-garamond/500-italic.css';
import '@fontsource/great-vibes/400.css';
import '@fontsource/amiri/400.css';
import '@fontsource/amiri/700.css';
import '../styles/global.css';
import { wedding } from '../data/wedding';

// base-aware asset prefix ('' locally, '/salman-weds-haani' on GitHub Pages)
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#f9f5ec" />
    <title>{wedding.meta.title}</title>
    <meta name="description" content={wedding.meta.description} />
    <meta property="og:title" content={wedding.meta.title} />
    <meta property="og:description" content={wedding.meta.description} />
    <meta property="og:type" content="website" />
    <link rel="icon" type="image/svg+xml" href={`${base}/favicon.svg`} />
  </head>
  <body class="locked">
    <canvas id="petals" aria-hidden="true"></canvas>
    <main>
      <slot />
    </main>

    <script>
      import { initPetals } from '../scripts/petals';
      import { initScroll } from '../scripts/scroll';
      import { initInteractions } from '../scripts/interactions';

      const canvas = document.getElementById('petals') as HTMLCanvasElement | null;
      if (canvas) initPetals(canvas);
      initScroll();
      initInteractions();
    </script>
  </body>
</html>
